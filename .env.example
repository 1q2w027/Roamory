# Copy to .env and fill in. Never commit .env.
# Bearer token the app sends to the backend (TRD 8.1)
APP_TOKEN=change-me
ANTHROPIC_API_KEY=
# Model IDs (config, not code): Stage 2a fast, Stage 2b strong, edit planner
STAGE2A_MODEL=claude-haiku-5-5
STAGE2B_MODEL=claude-sonnet-5-5
PLANNER_MODEL=claude-sonnet-5-5
# Edit planner (POST /v1/plan)
PLANNER_EFFORT=medium
PLAN_TIMEOUT_S=25
# Each clip sends 4 thumbnails; keep MAX_PLAN_CLIPS x 4 under the API's per-request image limit
MAX_PLAN_CLIPS=24
PLANS_PER_TRIP=5
# Moment evaluation (POST /v1/evaluate). 2a + 2b timeouts must fit the phone's 8 s timeout
STAGE2A_EFFORT=low
STAGE2A_TIMEOUT_S=3
STAGE2B_EFFORT=low
STAGE2B_TIMEOUT_S=4
SAVE_THRESHOLD=0.60
SAVE_ANYWAY_THRESHOLD=0.75
UNCERTAIN_BAND=0.08
# Per-trip budget (TRD 8.3)
BUCKET_CAPACITY=5
BUCKET_REFILL_S=30
FAST_PER_HOUR=100
STRONG_PER_HOUR=15
DESCRIBE_PER_HOUR=60
DEMO_MODE=false
# Render service (render/, POST /v1/render). Uses APP_TOKEN above; render/.env overrides.
PORT=3000
RENDER_CONCURRENCY=1
# Seconds an undownloaded output is kept after its job ends
RENDER_TTL_S=900
MAX_UPLOAD_MB=200
# Agent mode (POST /v1/agent, TRD 9.3): a Claude agent edits and renders the video. Uses ANTHROPIC_API_KEY above
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
AGENT_MAX_TURNS=60
# The phone gives up at 540 s, so keep this below it
AGENT_TIMEOUT_S=480
AGENT_MAX_RENDERS=3
AGENTS_PER_TRIP=3
# Per-job workspaces, relative to render/ (default .agent-work)
AGENT_WORK_DIR=
# Fly.io hosting (scripts/cloud-setup.sh, scripts/deploy.sh, scripts/use-cloud.sh).
# FLY_APP must be unique across Fly; the app is served at https://$FLY_APP.fly.dev
FLY_APP=
FLY_REGION=sjc
FLY_ORG=personal
