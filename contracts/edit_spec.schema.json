{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roamory.app/contracts/edit_spec.schema.json",
  "title": "EditSpec",
  "description": "Response of POST /v1/plan and output of the phone's fallback planner (TRD 9.1). The renderer consumes it. Rules the schema cannot express (ids exist, trims in bounds, button clips present, duration, captions) are in README.",
  "type": "object",
  "additionalProperties": false,
  "required": ["trip_id", "style", "output", "title", "clips", "music", "end_card"],
  "properties": {
    "trip_id": {"type": "string", "minLength": 1},
    "style": {
      "type": "string",
      "enum": ["cinematic", "reels", "documentary", "vlog"]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "description": "Copied from the style preset.",
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "integer", "minimum": 1}
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "subtitle", "duration_s"],
      "description": "Overlaid on the start of the first clip; adds no time.",
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 40},
        "subtitle": {"type": ["string", "null"], "maxLength": 60},
        "duration_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "description": "In playback order.",
      "items": {"$ref": "#/$defs/clip"}
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track", "gain_db", "duck_original_audio"],
      "properties": {
        "track": {
          "type": "string",
          "minLength": 1,
          "description": "Bundled track id, normally the preset's music_track."
        },
        "gain_db": {"type": "number", "maximum": 0},
        "duck_original_audio": {
          "type": "boolean",
          "description": "True: original clip audio is muted under the music. False: original audio plays (Vlog)."
        }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "duration_s"],
      "description": "Plays after the last clip, after a hard cut, and adds duration_s.",
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 40},
        "duration_s": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  },
  "$defs": {
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moment_id",
        "in_s",
        "out_s",
        "transition_in",
        "transition_s",
        "speed_ramp",
        "caption"
      ],
      "properties": {
        "moment_id": {"type": "string", "minLength": 1},
        "in_s": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds from the start of clips/{moment_id}.mp4."
        },
        "out_s": {"type": "number", "exclusiveMinimum": 0},
        "transition_in": {
          "type": "string",
          "enum": ["cut", "fade", "dissolve"],
          "description": "On the first clip, fade/dissolve means from black and overlaps nothing."
        },
        "transition_s": {
          "type": "number",
          "minimum": 0,
          "description": "0 when transition_in is cut. Otherwise the overlap with the previous clip."
        },
        "speed_ramp": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to", "over_s"],
              "description": "Playback-rate ramp over the first over_s source seconds of the trim. Rates are multipliers: 1 is real time, 4 is 4x fast (time-lapse). See README for the exact steps.",
              "properties": {
                "from": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
                "to": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
                "over_s": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          ]
        },
        "caption": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "Must exactly match an allowed string (README); null for none."
        }
      }
    }
  }
}
