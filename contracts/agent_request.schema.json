{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roamory.app/contracts/agent_request.schema.json",
  "title": "AgentRequest",
  "description": "request part of POST /v1/agent (render service, agent mode). The phone uploads one whole {moment_id}.mp4 per candidate clip; the agent selects, trims, edits and renders the video itself. Clip fields are the plan request's clip table, minus thumbnails, plus has_audio. Rules the schema cannot express are in README.",
  "type": "object",
  "additionalProperties": false,
  "required": ["trip_id", "style", "target_s", "effective_target_s", "context", "clips"],
  "properties": {
    "trip_id": {"type": "string", "minLength": 1},
    "style": {"$ref": "plan_request.schema.json#/$defs/style"},
    "target_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "The style preset's target_s.default."
    },
    "effective_target_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Same rule as the plan request (README, Effective target). The video's total_s must be within ±10 % of it."
    },
    "context": {"$ref": "render_request.schema.json#/properties/context"},
    "clips": {
      "type": "array",
      "minItems": 1,
      "description": "Every candidate clip after the phone's pre-pass, not only the ones a planner would pick. One {moment_id}.mp4 part per entry.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moment_id",
          "source",
          "event_type",
          "description",
          "score",
          "t_from_ms",
          "duration_s",
          "has_audio",
          "proposed_in_s",
          "proposed_out_s",
          "low_fps_lead_in_s"
        ],
        "properties": {
          "moment_id": {"$ref": "plan_request.schema.json#/$defs/clip/properties/moment_id"},
          "source": {"$ref": "plan_request.schema.json#/$defs/clip/properties/source"},
          "event_type": {"$ref": "plan_request.schema.json#/$defs/clip/properties/event_type"},
          "description": {"$ref": "plan_request.schema.json#/$defs/clip/properties/description"},
          "score": {"$ref": "plan_request.schema.json#/$defs/clip/properties/score"},
          "t_from_ms": {"$ref": "plan_request.schema.json#/$defs/clip/properties/t_from_ms"},
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Duration of the uploaded file: the whole clip, re-encoded at the upload preset."
          },
          "has_audio": {"type": "boolean"},
          "proposed_in_s": {"$ref": "plan_request.schema.json#/$defs/clip/properties/proposed_in_s"},
          "proposed_out_s": {"$ref": "plan_request.schema.json#/$defs/clip/properties/proposed_out_s"},
          "low_fps_lead_in_s": {"$ref": "plan_request.schema.json#/$defs/clip/properties/low_fps_lead_in_s"}
        }
      }
    }
  }
}
