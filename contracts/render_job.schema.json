{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roamory.app/contracts/render_job.schema.json",
  "title": "RenderJob",
  "description": "Body of GET /v1/render/{job_id}. The phone polls it until status is completed (then downloads the video) or failed (then renders on the phone).",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "status", "progress", "error"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["queued", "rendering", "completed", "failed"]
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Render progress. 1 when completed."
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "error.schema.json"}
      ],
      "description": "Null unless status is failed; then code is render_failed (or internal)."
    }
  }
}
