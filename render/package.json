{
  "name": "roamory-render",
  "private": true,
  "description": "Roamory render service: a Claude agent edits and renders the highlight video with Remotion (TRD §9, docs/agentic-video-generation.md).",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync-assets": "scripts/sync-assets.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.3.0",
    "multer": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "tsx": "4.23.15",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
