# One port for both services, the one Fly's proxy forwards to. See cloud/start.sh for the ports.
{
	admin off
}

:{$PORT}

# The video agent runs in the render service (TRD §9).
handle /v1/agent* {
	reverse_proxy 127.0.0.1:3001
}
handle /render/healthz {
	rewrite * /healthz
	reverse_proxy 127.0.0.1:3001
}
# /v1/evaluate, /healthz
handle {
	reverse_proxy 127.0.0.1:8001
}
