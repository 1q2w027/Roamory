// Base build settings for the Roamory target.
ROAMORY_DIRECTOR_MODEL = claude-haiku-5-5
ROAMORY_DIRECTOR_INTERVAL = 10
ROAMORY_DIRECTOR_FRAMES = 5
ROAMORY_NOTES_MODEL = claude-sonnet-5-5
ROAMORY_NOTES_SEARCH_USES = 3
ROAMORY_CHAT_MODEL = claude-haiku-5-5
// Seconds of footage before a moment that a clip started by the director begins with, and the length at which the
// app ends such a clip by itself. Clips saved by hand keep the whole 45 s buffer.
ROAMORY_DIRECTOR_PREROLL = 15
ROAMORY_DIRECTOR_MAX_CLIP = 40
// Share of what is filmed (percent) the director aims to save.
ROAMORY_DIRECTOR_SAVE_SHARE = 10
// 1: speech is transcribed on the iPhone and sent to the director with the frames; 0: frames only.
ROAMORY_DIRECTOR_HEARING = 1
// Capture frame rate (the closest the camera supports) and HEVC bit rate of the buffer, in bits per second.
ROAMORY_CAPTURE_FPS = 60
ROAMORY_VIDEO_BITRATE = 20000000
